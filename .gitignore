# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/
*/**/deps/*

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Rust output of the components
/target/
*/**/target/*

# Ignore wasmcloud build artifacts
*/**/build/*

# Generated WIT dependencies (regenerated via `wash/wkg wit fetch`)
**/wit/deps/

# Generated by `wash build` (regenerated on every build)
**/.wash/wasmcloud.lock

# publish files
/node_modules/

*.wasm

!/functions/upload-file/1.0/test/fixtures/*.wasm
