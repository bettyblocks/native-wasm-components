package betty-blocks:ai-agent@2.0.0;

interface ai-agent {
    use betty-blocks-types:types/types@2.2.0.{json-string};

    record ai-provider {
        name: string,
        ai-model-name: string,
        url: string,
        tools: option<list<json-string>>,
        api-key: string,
    }

    ai-agent: func(
        provider: ai-provider,
        instructions: string,
        message: string,
        max-tokens: option<u32>,
    ) -> result<string, string>;
}

world main {
    export ai-agent;
}
