package betty-blocks:ai-agent@2.0.0;

interface ai-agent {
    record ai-provider {
        name: string,
        ai-model-name: string,
        url: string,
    }

    ai-agent: func(
        provider: ai-provider,
        instructions: string,
        message: string,
        max-tokens: option<u32>,
    ) -> result<string, string>;
}

world main {
    import wasi:config/store@0.2.0-rc.1;

    export ai-agent;
}
