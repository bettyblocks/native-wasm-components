package betty-blocks:prompt-call@2.0.0;

interface prompt-call {
    use betty-blocks-types:types/types@3.2.0.{betty-ai-agent,betty-schema-model,json-string};

    record betty-flat-output {
        usage: json-string,
        %result: json-string
    }

    prompt-call: func(
        system-prompt: string,
        prompt: option<string>,
        ai-agent: betty-ai-agent,
        max-tokens: option<u32>,
        schema-model: option<betty-schema-model>,
    ) -> result<betty-flat-output, string>;
}

world main {
    export prompt-call;
}
