package betty-blocks:create@2.0.0;

interface create {
    use betty-blocks-types:data-api/data-api@2.0.0.{helper-context};
    use betty-blocks-types:types/types@2.0.0.{betty-model, betty-property-mapping};
    type json-string = string;

    record input {
        model: betty-model,
        mapping: betty-property-mapping,
        validates: bool
    }

    create: func(helper-context: helper-context, input: input) -> result<json-string, string>;
}

world main {
    import betty-blocks-types:crud/crud@2.0.0;
    export create;
}
