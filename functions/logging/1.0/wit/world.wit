package betty-blocks:logging@4.0.0;

interface logger {
    use betty-blocks-types:types/types@3.1.0.{json-string};

    /// The severities the step offers, a subset of wasi:logging's level.
    enum log-severity {
        debug,
        info,
        warn,
        error,
    }

    log: func(severity: log-severity, variables: json-string) -> result<_, string>;
}

world main {
    import wasi:logging/logging@0.1.0-draft;

    export logger;
}
